{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/hooks/block-dangerous-command.sh\"",
            "timeout": 30,
            "statusMessage": "Checking command policy"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/hooks/block-worktree-stash.sh\"",
            "if": "Bash(git stash:*)",
            "timeout": 30,
            "statusMessage": "Checking worktree policy"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/hooks/block-worktree-stash.sh\"",
            "if": "Bash(git -C * stash*)",
            "timeout": 30,
            "statusMessage": "Checking worktree policy"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/hooks/enforce-package-manager.sh\"",
            "timeout": 30,
            "statusMessage": "Checking package manager"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/agents/hooks/log-gam.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "static-analysis@trailofbits": false,
    "interslavic@esultanik-skills": true,
    "plugin-dev@claude-plugins-official": true,
    "writing-style@trailofbits": false,
    "audit-context-building@trailofbits": false,
    "issue-writer@trailofbits": false,
    "clangd-lsp@claude-plugins-official": true,
    "fix-review@trailofbits": false,
    "recruiting@trailofbits": true,
    "culture-index@trailofbits": true,
    "skill-creator@claude-plugins-official": true,
    "github-triage@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "esultanik-skills": {
      "source": {
        "source": "github",
        "repo": "esultanik/skills"
      },
      "autoUpdate": false
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      },
      "autoUpdate": false
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
